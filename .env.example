PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/ecommerce
SESSION_SECRET=replace_with_a_long_random_string
NODE_ENV=development
# Set this to the frontend's Render URL in production (e.g. https://shopport.onrender.com)
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth credentials — obtained from Google Cloud Console.
# GOOGLE_CALLBACK_URL must match an authorised redirect URI registered in the console.
# In local development this goes through the Vite proxy so the session cookie is set on
# the same origin the frontend uses. In production point it at the backend Render URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
